rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validator: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'email', 'xp', 'streak', 'level', 'createdAt'])
        && data.keys().size() <= 9
        && data.userId is string && data.userId.size() <= 128
        && data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.xp is int && data.xp >= 0
        && data.streak is int && data.streak >= 0
        && data.level is int && data.level >= 1;
    }

    // Entity validator: QuizSubmission
    function isValidQuizSubmission(data) {
      return data.keys().hasAll(['submissionId', 'userId', 'domainId', 'topicId', 'score', 'totalQuestions', 'correctAnswers', 'completedAt'])
        && data.keys().size() == 8
        && data.submissionId is string && data.submissionId.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.domainId is string && data.domainId.size() <= 100
        && data.topicId is string && data.topicId.size() <= 100
        && data.score is int && data.score >= 0 && data.score <= 100
        && data.totalQuestions is int && data.totalQuestions >= 0
        && data.correctAnswers is int && data.correctAnswers >= 0;
    }

    // Entity validator: SavedNote
    function isValidSavedNote(data) {
      return data.keys().hasAll(['noteId', 'userId', 'title', 'concept', 'explanation', 'createdAt'])
        && data.keys().size() == 6
        && data.noteId is string && data.noteId.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.concept is string && data.concept.size() <= 100
        && data.explanation is string && data.explanation.size() <= 10000;
    }

    // Matches for UserProfile and its subcollections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) 
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'xp', 'streak', 'level', 'completedTopics', 'updatedAt'])
        );
      allow delete: if false;

      match /quizSubmissions/{submissionId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidQuizSubmission(incoming()) && incoming().userId == request.auth.uid && incoming().completedAt == request.time;
        allow update, delete: if false;
      }

      match /savedNotes/{noteId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSavedNote(incoming()) && incoming().userId == request.auth.uid && incoming().createdAt == request.time;
        allow update: if isOwner(userId) && isValidSavedNote(incoming()) 
          && incoming().noteId == existing().noteId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'concept', 'explanation']);
        allow delete: if isOwner(userId);
      }
    }
  }
}
